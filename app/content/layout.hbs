<!doctype html>
<html class="no-js" lang="de">
	<head>
    {{> partials/meta pageTitle=this.pageTitle pageDescription=this.pageDescription }}
    {{> partials/styles }}
	</head>
	<body>
    <div id="overall-wrapper">
	    {{> partials/header pageId=this.pageId }}
       <div class="content {{this.pageId}}">
         <button id="menu" aria-label="Menü öffnen" aria-expanded="false" class="hamburger hamburger--spin" type="button">
           <span class="hamburger-box">
             <span class="hamburger-inner"></span>
           </span>
         </button>
          <header>
            <p><span>Dipl.-Psych.</span> Silvia Mohadjer-Chouaf</p>
            <h1>Psychologische Psychotherapeutin <span>und</span> Psychoanalytikerin (DGPT) in Freiburg</h1>
          </header>
        {{> content }}
        {{> partials/footer }}
      </div>
    </div>
    {{> partials/scripts }}
	</body>
</html>
